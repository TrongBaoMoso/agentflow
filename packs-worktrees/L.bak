  @GwtIncompatible
  TypeMethods __methods = TYPE.methods(new TypeMethods() {
    @Override
    public void beforeCreated(CanBeStored<?> bean) {
      WebinarAttendee.__beforeCreated.accept(bean);

      // Origin stamp: first thing, and independent of the attribution block below (which is gated on
      // isChanged(referred_by)). Recomputes every derived stamp field; nothing on the bean is trusted.
      LeadOriginStamp.resolveOnCreate(bean);

      setDefaultValueIfMissing(bean, pending_approval, false);
      setDefaultValueIfMissing(bean, block_display, false);
      setDefaultValueIfMissing(bean, recruiting_type, RecruitingType.interested);
      setDefaultValueIfMissing(bean, hr_status, HrStatus.not_initiated);
      setDefaultValueIfMissing(bean, onboarding_meeting_status, StatusMeeting.unselect);
      bean.set(total_reviews, 0);
      bean.set(avg_rating, 0D);

      boolean hasSocialLinks = bean.hasValue(stored_social_links);
      setDefaultValueIfMissing(bean, check_social_media, hasSocialLinks);
      setDefaultValueIfMissing(bean, has_social_media, hasSocialLinks);

      if (bean.is(recruiting_type, RecruitingType.recruiting)) {
        setDefaultValueIfMissing(bean, out_source_status, OutSourceStatus.not_touched);
        setDefaultValueIfMissing(bean, friendship, Friendship.not_friend);
        setDefaultValueIfMissing(bean, claimed_profile, false);
      }

      if (bean.is(recruiting_type, RecruitingType.interested)) {
        if (bean.is(ready_to_join)) {
          bean.add(lo_labels, "Ready to join");
        } else if (bean.is(register_for_webinar) && !bean.hasValue(webinar)) {
          HasValues nextWebinar = GetNextWebinarOp.get(bean.bundle(), WebinarType.loan_officer_recruiting);
          if (nextWebinar != null) {
            bean.set(webinar, nextWebinar.id());
          }
        }

        if (bean.isChanged(LORecruiting.referred_by)) {
          if (bean.hasValue(LORecruiting.referred_by)) {
            Bean referAdmin = new Bundle().find(Admin.TYPE)
                    .whereEquals(Admin.company_email, bean.get(LORecruiting.referred_by))
                    .whereEquals(Admin.active, true)
                    .first();
            if (referAdmin != null) {
              if (bean.is(LORecruiting.referred_source, LoanOfficerReferredSource.recruiter)
                      && (referAdmin.is(Admin.is_recruiter) || referAdmin.is(Admin.is_out_sourcing_recruiter))) {
                bean.set(LORecruiting.recruiter, referAdmin.keyName());
              } else if (referAdmin.is(Admin.is_loan_originator)) {
                LoRecruiterProgramStanding.Outcome credit = LoRecruiterProgramStanding.creditFor(bean, referAdmin);
                if (credit == LoRecruiterProgramStanding.Outcome.RECRUITER) {
                  // Approved LO Recruiter Program member without the HR flag, through their own site (server-resolved
                  // slug stamp + moso-aid standing): stored exactly as an HR-flagged recruiter's lead is.
                  bean.set(LORecruiting.recruiter, referAdmin.keyName());
                } else {
                  bean.set(LORecruiting.referred_lo, referAdmin.keyName());
                  bean.set(LORecruiting.referred_source, LoanOfficerReferredSource.loan_officer);
                  if (credit == LoRecruiterProgramStanding.Outcome.UNVERIFIED) {
                    // The standing lookup failed (not "no"): leave a visible trace so the lead can be reviewed.
                    bean.add(LORecruiting.lo_labels, LoRecruiterProgramStanding.UNVERIFIED_LABEL);
                  }
                }
              }
            }
          } else {
            bean.remove(LORecruiting.recruiter);
            bean.remove(LORecruiting.referred_lo);
          }
        }

        if (bean.is(referred_source, LoanOfficerReferredSource.recruiter)) {
          if (bean.hasValue(referred_by)) {
            java.util.Optional<? extends CanBeStored> foundRecruiter = bean.bundle().find(Admin.TYPE)
                    .whereEquals(Admin.company_email, bean.get(referred_by))
                    .whereEquals(Admin.active, true)
                    .whereEquals(Admin.is_lock, false)
                    .list().stream()
                    .filter(admin -> admin.get(Admin.role).isAnyRecruiter()).findFirst();
            foundRecruiter.ifPresent(canBeStored -> bean.set(recruiter, canBeStored.keyName()));
          } else if (App.currentUser().get(Admin.role).isAnyRecruiter()) {
            bean.set(recruiter, App.currentUsername());
          }
        } else if (bean.is(referred_source, LoanOfficerReferredSource.loan_officer)
                && !bean.hasValue(referred_by)
                && App.currentUser().get(Admin.role).isLoanOriginator()) {
          bean.set(referred_by, App.currentUser().get(Admin.company_email));
        }

        Stream.of(added_by_admin, paid_startup_fee, lo_agreement_signed)
                .forEach(f -> setDefaultValueIfMissing(bean, f, false));
      }

      Bundle bundle = new Bundle();
      Bean communicationStatistic = bundle.create(CommunicationStatistic.TYPE);
      communicationStatistic.save();
      bean.set(Loan.communication_statistic, communicationStatistic.id());
      if (checkUserInBlackListOp(bean.toMap(email, phone).set(BlackListUser.originator_nmls, bean.get(nmls)), bundle)) {
        bean.set(is_blacklisted, true);
      }
      if (checkNotEligibleForRehire(bean, bundle)) {
        bean.add(lo_labels, "Warning: LO is not eligible for rehire");
      }
    }

    private <T> void setDefaultValueIfMissing(HasValues bean, Field<T> field, T value) {
      if (!bean.hasValue(field)) {
        bean.set(field, value);
      }
    }

    @Override
    public void beforeSave(CanBeStored<?> bean) {
      Bundle bundle = new Bundle();
      if (bean.getOldValues().hasValue(recruiting_type)
              && bean.is(recruiting_type, RecruitingType.interested)) {
        bean.add(lo_labels, true, "Converted from recruited LO");
      }
      if (bean.is(recruiting_type, RecruitingType.recruiting)) {
        if (bean.isChanged(nmls) && bean.hasValue(nmls) && bean.bundle().find(TYPE).whereEquals(nmls, bean.get(nmls)).exists()) {
          throw new ErrorMessage("Duplicated NMLS");
        }
        if (!(bean.hasValue(started_date) || bean.isNew())) {
          bean.set(started_date, Dates.dates.getISOStringFromDate(new Date()));
        }
      }

      if (!bean.isNew() && (bean.isChanged(email) || bean.isChanged(nmls))) {
        bean.set(is_blacklisted, false);
        bean.remove(lo_labels, "Warning: LO is not eligible for rehire");
        Bundle checkBundle = new Bundle();
        JSON checkInput = bean.toMap(email, phone).set(BlackListUser.originator_nmls, bean.get(nmls));
        if (checkUserInBlackListOp(checkInput, checkBundle)) {
          bean.set(is_blacklisted, true);
        }
        if (checkNotEligibleForRehire(bean, checkBundle)) {
          bean.add(lo_labels, "Warning: LO is not eligible for rehire");
        }
      }
      if (bean.isChanged(stored_social_links)) {
        bean.set(has_social_media, bean.hasValue(stored_social_links));
      }

      // agentflow-tdqcv: first acknowledgement wins; the timestamp is legal evidence, so it is never rewritten.
      // Tamper-proof on every save path (public body, admin, generic SaveOp): an existing stamp is restored, and
      // once stamped the acknowledgement cannot be withdrawn.
      Date stampedAt;
      if (bean.isNew()) {
        stampedAt = null;
      } else if (bean.isChanged(mortgage_website_approval_ack_at)) {
        stampedAt = bean.getOldValues().get(mortgage_website_approval_ack_at);
      } else {
        stampedAt = bean.get(mortgage_website_approval_ack_at);
      }
      if (stampedAt != null) {
        bean.set(mortgage_website_approval_ack_at, stampedAt);
        bean.set(mortgage_website_approval_ack, true);
      } else if (bean.is(mortgage_website_approval_ack, true)) {
        bean.set(mortgage_website_approval_ack_at, new Date());
      } else if (bean.hasValue(mortgage_website_approval_ack_at)) {
        // Only clear a stamp that truly must go: Bean.remove always marks the field changed, and a stale bean's
        // save would replay that removal onto a row another bean has just stamped.
        bean.remove(mortgage_website_approval_ack_at);
      }
      // A stored answer can be changed Yes<->No on any save path, but never set back to "never answered".
      if (!bean.isNew() && bean.isChanged(has_mortgage_website) && bean.get(has_mortgage_website) == null
              && bean.getOldValues().get(has_mortgage_website) != null) {
        bean.set(has_mortgage_website, bean.getOldValues().get(has_mortgage_website));
      }

      if ((bean.isChanged(nmls_status) || bean.isChanged(hr_status) || bean.isChanged(onboarding_meeting_status))
              && bean.is(nmls_status, NmlsStatus.sponsored)
              && bean.is(hr_status, HrStatus.completed)
              && bean.is(onboarding_meeting_status, StatusMeeting.setup_done)) {
        bean.set(status, WebinarAttendeeStatus.joined);
      }
      if (bean.isChanged(hr_status) && bean.is(hr_status, HrStatus.completed) && bean.hasValue(onboarding_specialist)) {
        sendEmailWhenHrCompleted(bean);
      }

      if (bean.isChanged(status)) {
        if (bean.is(status, WebinarAttendeeStatus.interviewed_and_accepted)) {
          Server.queueService().addTask(EmailTemplateOp.class,
                  JSON.make(EmailParams.template, "onboarding_interested_loan_officer")
                          .set("root", bean.key()));
        }

        if (bean.is(status, WebinarAttendeeStatus.hiatus)) {
          Date nextMonth = new Date();
          nextMonth.setMonth(nextMonth.getMonth() + 1);
          String recipient = bean.hasValue(LORecruiting.onboarding_specialist) ? "$" + LORecruiting.onboarding_specialist.name() : "";

          Server.queueService(QueueType.DEFAULT).addTask(SaveFollowUpOp.class, FieldsBase.create()
                  .set(ToFollowUp.container, bean.key())
                  .set(ToFollowUp.recipient_fks, Collections.singletonList(recipient))
                  .set(ToFollowUp.note, "FU is created automatically by system")
                  .set(ToFollowUp.send_email, true)
                  .set(ToFollowUp.send_text, false)
                  .set(ToFollowUp.system_notification, false)
                  .set(ToFollowUp.wakeup_date_tz, Dates.dates.getISOStringFromDate(nextMonth)));
        }

        bean.set(is_actively_recruiting, bean.isIn(LORecruiting.status, WebinarAttendeeStatus.interested, WebinarAttendeeStatus.invited_to_join));
        bean.set(is_not_onboarded, bean.isIn(LORecruiting.status, WebinarAttendeeStatus.interested, WebinarAttendeeStatus.invited_to_join,
                WebinarAttendeeStatus.interviewed_and_accepted, WebinarAttendeeStatus.no_response, WebinarAttendeeStatus.interviewed_and_rejected,
                WebinarAttendeeStatus.denied_by_LO));
      }
      if (bean.isChanged(give_nmls_access) && bean.is(give_nmls_access)
              && (!bean.hasValue(nmls_status) || bean.is(nmls_status, NmlsStatus.no_access_right))) {
        bean.set(nmls_status, NmlsStatus.access_right_is_given);
      }

      bean.set(owners_of_lo, Stream.of(loan_officer_assistant, onboarding_specialist, support_specialist, recruiter)
              .filter(bean::hasValue).map(bean::get).collect(Collectors.toList()));

      if (Server.isEnabledModule("SUBSCRIPTION") && bean.hasValue(LORecruiting.email) && (bean.isChanged(LORecruiting.email) || bean.isChanged(LORecruiting.phone))) {
        Server.queueService(QueueType.SUBSCRIPTION).addTask(CheckAndUpdateLORecruitingForSubscription.class, JSON.empty().set(LORecruiting.id, bean.id()));
      }

      if (bean.isChanged(out_source_status)) {
        bean.set(block_display, bean.isIn(out_source_status, OutSourceStatus.archived_wrong_information, OutSourceStatus.block_display));
        bean.set(out_source_active, bean.isNot(block_display) && bean.isNot(out_source_status, OutSourceStatus.archived));
      }

      if (bean.isChanged(google_place_id)) {
        if (bean.hasValue(google_place_id)) {
          try {
            JSON reviews = new FindGoogleReviews().execute(JSON.empty().copyFrom(bean, google_place_id));
            bean.copyFrom(reviews, total_reviews, avg_rating, google_url);
          } catch (Exception ex) {
            Logger.getLogger(LORecruiting.class.getName()).warn("Could not get LORecruiting google place reviews: " + bean.id());
          }
        } else {
          bean.removeAll(total_reviews, avg_rating);
        }
      }


      if (bean.is(recruiting_type, RecruitingType.interested)) {
        if (Stream.of(first_name, last_name, email, recruiting_type).anyMatch(bean::isChanged)) {
          JSON data = JSON.empty().set(Admin.key, bean.key()).set(LORecruiting.full_name, bean.get(LORecruiting.full_name));
          if (bean.isChanged(LORecruiting.email)) {
            data.set(LORecruiting.email, bean.get(LORecruiting.email));
            data.set(HasKey.old_values, bean.getOldValues());
          }
          Server.queueService(QueueType.DRIVE).addTask(UpdateAssociateToDoFolderOp.class, data, 3000);
        }
        if (bean.isChanged(webinar)) {
          bean.set(not_registered_webinar, !bean.hasValue(webinar));
        }
      }

      if (bean.isChanged(LORecruiting.onboarding_specialist) || bean.isChanged(LORecruiting.recruiter)) {
        LoanOps.createDefaultFollowUpForLORecruiting(bean);
      }

      WebinarAttendee.__checkAndUpdateStatus.accept(bean);

      if (bean.isChanged(referred_by)) {
        if (bean.hasValue(referred_by)) {
          String name = bean.get(LORecruiter.recruiter_name, "");
          if (Strings.isEmpty(name)) {
            Bean admin = bundle.find(Admin.TYPE)
                    .whereEquals(Admin.company_email, bean.get(referred_by)).first();
            name = (admin == null) ? bean.get(referred_by) : admin.get(Admin.full_name);
          }
          bean.set(LORecruiting.added_by_referrer_label, "Referred by " + name);
        } else {
          bean.set(LORecruiting.added_by_referrer_label, "");
        }
      }

      if (bean.isChanged(referred_source)) {
        if (bean.hasValue(referred_source)) {
          bean.set(referred_section, bean.get(referred_source).section());
        }
        if (bean.isNot(referred_section, LoanOfficerReferredSection.other)) {
          bean.remove(referred_source_other_reason);
        }
        if (bean.isNot(referred_source, LoanOfficerReferredSource.loan_officer)) {
          bean.remove(LORecruiting.join_lf_recruiter_group);
        }
        if (!bean.isIn(referred_source, LoanOfficerReferredSource.outside_loan_officer, LoanOfficerReferredSource.others)) {
          bean.remove(referrer_have_zelle_account);
          bean.remove(is_zelle_info_same_as_contact_info);
          bean.remove(zelle_the_referrer_bonus);
          bean.remove(referral_zelle_info);
          bean.remove(referral_preferred_payment_method);
        }
      }

      bean.set(on_boarding_meeting_completed_but_hr_not_initiated, bean.is(onboarding_meeting_status, StatusMeeting.pre_onboarding_done) && bean.hasValue(hr_status) && bean.is(hr_status, HrStatus.not_initiated));
      if (bean.hasValue(paid_startup_fee) && bean.hasValue(lo_agreement_signed)) {
        bean.set(paid_but_not_signed, bean.is(paid_startup_fee) && bean.isNot(lo_agreement_signed));
      }
      if (bean.hasValue(nmls_status) && bean.hasValue(hr_status)) {
        bean.set(nmls_sponsored_but_hr_onboarding, bean.is(nmls_status, NmlsStatus.sponsored) && bean.is(hr_status, HrStatus.in_progress));
        bean.set(hr_completed_but_nmls_not_sponsored, bean.isIn(nmls_status, NmlsStatus.no_access_right, NmlsStatus.access_right_is_given, NmlsStatus.applied_for_sponsorship, NmlsStatus.active_license_items) && bean.is(hr_status, HrStatus.completed));
      }

      updateSponorDuration(bean);

      if (bean.isChanged(paypal_order_id) && bean.hasValue(paypal_order_id)
              && bean.isIn(status, WebinarAttendeeStatus.no_response, WebinarAttendeeStatus.interviewed_and_rejected,
              WebinarAttendeeStatus.denied_by_LO)) {
        AutoEscalationDesk.createAutoEscalationTicket(bean, AutoEscalationDesk.ILO_ARCHIVED_BUT_STARTUP_PAYMENT_PROCESSED);
      }

      if ((bean.isChanged(paid_startup_fee) && bean.is(paid_startup_fee))
              || (bean.isChanged(lo_agreement_signed) && bean.is(lo_agreement_signed))
              || (bean.isChanged(nmls_status) && bean.is(nmls_status, NmlsStatus.access_right_is_given))) {
        bean.set(LORecruiting.status, WebinarAttendeeStatus.interviewed_and_accepted);
      }

      if (bean.isChanged(LORecruiting.is_loan_referral)) {
        if (bean.is(LORecruiting.is_loan_referral)) {
          bean.add(lo_search_labels, true, LORecruiting.is_loan_referral.label());
        } else {
          bean.remove(lo_search_labels, LORecruiting.is_loan_referral.label());
        }
      }

      if (App.currentUser() == null && bean.is(recruiting_type, RecruitingType.interested) && bean.hasValue(recruiter)
              && bean.is(status, WebinarAttendeeStatus.no_response) && hasProfileChanges(bean)) {
        Server.queueService().addTask(EmailTemplateOp.class,
                JSON.make(EmailParams.template, "ilo_return").set("root", bean.key()));
      }
    }

    private boolean hasProfileChanges(CanBeStored<?> bean) {
      HasValues oldValues = bean.getOldValues();
      return Stream.of(
              first_name, last_name, alias_first_name, email, phone,
              street, city, zip, state, county_name, mailing_street, mailing_city, mailing_zip, mailing_state,
              nmls, brokerage, confirm_sponsorship, is_corporate_loan_officer, target_compensation, rocket_target_compensation,
              have_social_links, citizenship,
              referred_by, referrer_name, referrer_phone, referrer_have_zelle_account,
              zelle_the_referrer_bonus, referral_zelle_info, referral_preferred_payment_method
      ).anyMatch(bean::isChanged)
              || isListFieldChanged(bean, oldValues, states)
              || isListFieldChanged(bean, oldValues, sponsor_states)
              || isListFieldChanged(bean, oldValues, preferred_languages)
              || isListFieldChanged(bean, oldValues, stored_social_links);
    }

    private boolean isListFieldChanged(CanBeStored<?> bean, HasValues oldValues, Field<?> field) {
      if (!bean.isChanged(field)) {
        return false;
      }
      List<?> newList = bean.get(field) instanceof List ? (List<?>) bean.get(field) : null;
      List<?> oldList = oldValues.get(field) instanceof List ? (List<?>) oldValues.get(field) : null;
      if (Colls.isEmpty(newList) && Colls.isEmpty(oldList)) {
        return false;
      }
      return !Objects.equals(newList, oldList);
    }

    @Override
    public void afterCreated(CanBeStored<?> bean) {
      //Add Recruited loan officers to the LO newsletter subscriptions
      if (bean.is(recruiting_type, RecruitingType.recruiting)) {
        Server.queueService(QueueType.SUBSCRIPTION).addTask(AddLORecruitingToSubscriptionOp.class, JSON.empty().copyFrom(bean, Contact.first_name, Contact.last_name, Contact.phone, Contact.email));
      }

      Server.queueService().addTask(ILOAutomaticAssignOwnerOp.class, JSON.empty().set(LORecruiting.key, bean.key()));
    }

    @Override
    public void afterSave(CanBeStored<?> bean) {
      ensureIloESignDocumentsForOfficer(bean);
      sendUpdateNotificationEmailToLOA(bean, lo_agreement_signed);
      sendUpdateNotificationEmailToLOA(bean, paid_startup_fee);
      notifyReffererAboutStatus(bean);
      emailReferrerWhenILOAttend(bean);

      updateSummaryStatistic(bean);

      if (Stream.of(recruiting_type, block_display, pending_approval).anyMatch(bean::isChanged)) {
        Server.cache().delete(Admin.LOAN_OFFICERS_TOTAL_CACHE);
      }

      if (bean.is(waive_startup_fee) && bean.isChanged(waive_startup_fee_reason)) {
        Server.queueService().addTask(SaveGenericNoteOp.class, JSON.empty()
                .set(Note.container, bean.key())
                .set(Note.content, "Reason to waive start up fee: " + bean.get(waive_startup_fee_reason)));
      }

      if (bean.isChanged(referred_by) && bean.getOldValues().hasValue(referred_by)) {
        String oldReferredBy = bean.getOldValues().get(referred_by);
        Server.queueService(QueueType.ADMIN).addTask(EnsureLORecruiterOp.class, JSON.empty().copyFrom(bean.toMap())
                .set("old_referred_by", oldReferredBy, StringType.instance())
                .set(HasKey.key, bean.key())
        );
      }
      if (Stream.of(recruiting_type, active, referred_by).anyMatch(bean::isChanged)) {
        List<String> referredByEmails = Stream.of(bean, bean.getOldValues())
                .map(referred_by).filter(Strings::isNotEmpty)
                .collect(Collectors.toList());
        Server.queueService().addTask(UpdateReferralLoanOfficerReport.class, JSON.empty().set(Admin.company_email.s(), referredByEmails));
      }

      if (bean.isChanged(webinar) && bean.hasValue(webinar)) {
        Bundle bundle = new Bundle();
        Bean joinedWebinar = bundle.get(Webinar.TYPE, bean.get(webinar));
        joinedWebinar.add(Webinar.guests, true, bean.get(email));
        joinedWebinar.save();
      }

      if (bean.is(recruiting_type, RecruitingType.interested) &&
              bean.isChanged(status) &&
              bean.is(status, WebinarAttendeeStatus.joined)) {
        Bundle bundle = new Bundle();
        Bean adminConvertFromILO = bundle.find(Admin.TYPE).whereEquals(Admin.converted_from_ilo, bean.key()).first();
        if (adminConvertFromILO != null) {
          adminConvertFromILO.set(Admin.is_pending_loan_officer, false);
          adminConvertFromILO.save();
          sendEmailWhenILOJoinedCompany(adminConvertFromILO);
        }
      }

      if (bean.isChanged(paid_startup_fee) && bean.is(paid_startup_fee)) {
        Server.queueService(QueueType.EMAIL).addTask(EmailTemplateOp.class,
                JSON.make(EmailParams.template, "email/paid_startup_fee_by_ilo").set("root", bean.key()));
        Server.queueService(QueueType.EMAIL).addTask(EmailTemplateOp.class,
                JSON.make(EmailParams.template, "email/paid_startup_fee_successfully").set("root", bean.key()));
      }

      if (bean.isChanged(onboarding_meeting_status) && bean.is(onboarding_meeting_status, StatusMeeting.pre_onboarding_done)) {
        if (LOAN_FACTORY.equals(App.ns())) {
          // agentflow-7mwf0: a RECRUIT_V2 row gets this same e-mail; it is the "complete your registration"
          // mail of Option C, and its register-page link lands an incomplete profile on its first step.
          Server.queueService(QueueType.EMAIL).addTask(EmailTemplateOp.class,
                  JSON.make(EmailParams.template, "pre_onboarding_done").set("root", bean));
        }
      }
      sendBackgroundCheckEmailToILO(bean);
      createEscalationDeskTicket(bean);
      if (LOAN_FACTORY.equals(App.ns())) {
        Server.queueService(QueueType.DEFAULT).addTask(SyncStatusModex.class, JSON.empty());
      }
    }

    private void sendBackgroundCheckEmailToILO(CanBeStored<?> bean) {
      if (!LOAN_FACTORY.equals(App.ns())) {
        return;
      }
      boolean triggerFieldChanged = Stream.of(status, paid_startup_fee, lo_agreement_signed, sponsor_states)
              .anyMatch(bean::isChanged);
      boolean conditionsMet = bean.is(status, WebinarAttendeeStatus.interviewed_and_accepted)
              && bean.is(paid_startup_fee)
              && bean.is(lo_agreement_signed)
              && bean.hasValue(sponsor_states)
              && bean.get(sponsor_states).stream().anyMatch(BACKGROUND_CHECK_SPONSOR_STATES::contains);
      if (triggerFieldChanged && conditionsMet) {
        Server.queueService(QueueType.EMAIL).addTask(EmailTemplateOp.class,
                JSON.make(EmailParams.template, "ILO_completes_background_check").set("root", bean.key()));
      }
    }

    private boolean hasRefferEmail(CanBeStored bean) {
      return bean.hasValue(LORecruiting.referred_by) &&
              bean.isIn(LORecruiting.referred_source,
                      LoanOfficerReferredSource.recruiter,
                      LoanOfficerReferredSource.loan_officer,
                      LoanOfficerReferredSource.others);
    }

    private void updateSponorDuration(CanBeStored bean) {
      if (bean.is(recruiting_type, RecruitingType.interested)) {
        if (bean.isChanged(nmls_status)) {
          if (bean.is(nmls_status, NmlsStatus.access_right_is_given)) {
            bean.set(temporary_nmls_sponsor_first_day, new Date());
          }
          if (bean.is(nmls_status, NmlsStatus.sponsored) && bean.hasValue(temporary_nmls_sponsor_first_day)) {
            bean.set(nmls_sponsor_first_day, bean.get(temporary_nmls_sponsor_first_day));
            bean.set(nmls_sponsor_last_day, new Date());
            bean.set(temporary_nmls_sponsor_first_day, null);
          }
        }

        if (bean.hasValue(sponsor_states)
                && bean.get(sponsor_states).size() == 1
                && bean.hasValue(nmls_sponsor_first_day)
                && bean.hasValue(nmls_sponsor_last_day)) {
          bean.set(sponsor_state, bean.get(sponsor_states).get(0));
        } else {
          bean.set(sponsor_state, null);
        }
      }
    }

    private void updateSummaryStatistic(CanBeStored<?> bean) {
      if (bean.is(recruiting_type, RecruitingType.interested)
              ? INTERESTED_SUMMARY_STATISTIC_WATCH_FIELD.stream().anyMatch(bean::isChanged)
              : bean.isChanged(recruiting_type)) {
        Server.queueService(QueueType.DEFAULT).addTask(UpdateInterestedLoanOfficerStatisticOp.class,
                StatisticUtils.oldValuesFromBean(bean, INTERESTED_SUMMARY_STATISTIC_WATCH_FIELD));
      }
    }

    /**
     * The ONE dispatch point for {@link EnsureSigningSessionsRegisterInterestedLoanOfficer} off an
     * ILO save (agentflow-qo5my review). A legal-name correction that needs the envelope
     * regenerated is folded into THIS payload — {@code force_regenerate=true} — rather than a
     * second, separate queue add: two queue adds off the same save race each other against the
     * same envelope (two Inkless emails, or an orphaned envelope), whichever queue worker happens
     * to run first.
     *
     * <p>Widened on purpose: the original condition only fired on {@code onboarding_meeting_status}
     * or {@code onboarding_specialist} changing. A legal name corrected AFTER the meeting (both of
     * those already settled, unchanged by this save) still needs to reach this method, or a stale
     * envelope from before the correction would never be caught.</p>
     */
    private void ensureIloESignDocumentsForOfficer(CanBeStored<?> officer) {
      boolean meetingOrSpecialistChanged =
              officer.isChanged(onboarding_meeting_status) || officer.isChanged(onboarding_specialist);
      // agentflow-7mwf0: ONLY a row stamped RECRUIT_V2 widens what counts as an input change; for every
      // other row this stays false and the method is the legacy one, line for line.
      boolean recruitV2 = isRecruitV2(officer);
      // agentflow-gglqk: for a V2 row, a form that re-posts "" where the row holds nothing is not a new
      // legal name. The legacy row keeps the plain isChanged it always had.
      boolean legalNameChanged = recruitV2
              ? changedIgnoringBlank(officer, legal_given_name) || changedIgnoringBlank(officer, legal_last_name)
              : officer.isChanged(legal_given_name) || officer.isChanged(legal_last_name);
      boolean otherInputsChanged = recruitV2 && agreementInputsChanged(officer);
      // agentflow-gglqk: the keyless email-dedupe submit completes the profile and redirects without ever
      // calling registerSigningAgreement, so for a V2 row the completion itself must ask for the build.
      boolean profileJustCompleted = recruitV2 && profileJustCompleted(officer);
      if (!(meetingOrSpecialistChanged || legalNameChanged || otherInputsChanged || profileJustCompleted)
              || !officer.hasValue(onboarding_specialist)
              || !officer.is(onboarding_meeting_status, StatusMeeting.pre_onboarding_done)) {
        return;
      }
      if (recruitV2 && !officer.is(completed_detail_form)) {
        // No profile yet, so the envelope would be built from an empty row: wrong documents or blanks, and
        // a billable Inkless envelope (staging uses the production account). The first profile submit,
        // registerSigningAgreement, builds it fresh.
        Logger.getLogger(LORecruiting.class.getName()).info(
                "Skipping the e-sign build for " + officer.key() + ": RECRUIT_V2 row, profile not completed yet");
        return;
      }
      try {
        // This path only generates the e-sign documents. The op emails only when
        // EmailParams.template is present, and that email is the admin re-generate action's job.
        JSON payload = officer.toMap();
        boolean inputsChanged = legalNameChanged || otherInputsChanged;
        boolean envelopeOnFile = (inputsChanged || profileJustCompleted) && hasUnsignedInklessEnvelope(officer.key());
        boolean forceRegenerate = inputsChanged && envelopeOnFile;
        if (!(meetingOrSpecialistChanged || legalNameChanged) && !forceRegenerate) {
          // Only a V2 trigger is left (a profile edit or the profile's completion) and there is no
          // envelope to rebuild. Legacy rows never get here: their only triggers are the two above.
          if (profileJustCompleted && !envelopeOnFile) {
            queueProfileCompletedBuild(officer.key());
          }
          return;
        }
        if (forceRegenerate) {
          payload.set("force_regenerate", true, BooleanType.instance());
        }
        Server.queueService(QueueType.DEFAULT).addTask(EnsureSigningSessionsRegisterInterestedLoanOfficer.class, payload);
      } catch (Exception ex) {
        // Best-effort, and this runs INSIDE the same save as the meeting/specialist/legal-name
        // write (agentflow-qo5my review): a failure here — the envelope-lookup query, a queue
        // outage — must never escape afterSave and turn an already-committed write into a
        // caller-visible failure (RecruitAPI.onboardingMeeting's handle() wrapper would otherwise
        // report {"updated":false,"error":...} for a row that was, in fact, written). No PII in
        // the log: officer.key() only, never the name itself.
        Logger.getLogger(LORecruiting.class.getName()).warn(
                "Could not queue EnsureSigningSessionsRegisterInterestedLoanOfficer for " + officer.key(), ex);
      }
    }

    /**
     * What the agreement PDF and its document selection are filled from, other than the legal name:
     * NMLS, the address parts {@code full_address} joins, and the classification inputs of
     * {@code EnsureSigningSessionsRegisterInterestedLoanOfficer.computeRequiredDocs} (W-2/1099, CA
     * sponsorship and DRE endorsement, licensed states). Only consulted for {@link #isRecruitV2} rows.
     */
    private boolean agreementInputsChanged(CanBeStored<?> officer) {
      // agentflow-gglqk: compared by VALUE, so an identical step-0 resubmit is not a change: the state
      // lists as sets (the form may post them in another order), "" the same as absent (street2 etc.).
      return Stream.of(nmls, street, street2, city, state, zip, is_corporate_loan_officer, has_dre_endorsed)
              .anyMatch(field -> changedIgnoringBlank(officer, field))
              || isListFieldChangedAsSet(officer, states)
              || isListFieldChangedAsSet(officer, sponsor_states);
    }

    /** {@code isChanged}, except that "" (or whitespace) and absent count as the same value. */
    private boolean changedIgnoringBlank(CanBeStored<?> officer, Field<?> field) {
      if (!officer.isChanged(field)) {
        return false;
      }
      return !Objects.equals(blankToNull(officer.get(field)), blankToNull(officer.getOldValues().get(field)));
    }

    private static Object blankToNull(Object value) {
      return value instanceof String && ((String) value).trim().isEmpty() ? null : value;
    }

    /**
     * Whether a list field changed as a SET: order and duplicates do not count, and null equals empty.
     * Only for the V2 rebuild inputs; {@link #isListFieldChanged} keeps its ordered compare for the
     * legacy callers ({@code hasProfileChanges}).
     */
    private boolean isListFieldChangedAsSet(CanBeStored<?> officer, Field<?> field) {
      if (!officer.isChanged(field)) {
        return false;
      }
      return !asSet(officer.get(field)).equals(asSet(officer.getOldValues().get(field)));
    }

    private static Set<Object> asSet(Object value) {
      return value instanceof List ? new java.util.HashSet<>((List<?>) value) : Collections.emptySet();
    }

    /** {@code completed_detail_form} went from false or absent to true in this save. */
    private boolean profileJustCompleted(CanBeStored<?> officer) {
      return officer.isChanged(completed_detail_form) && officer.is(completed_detail_form)
              && !Boolean.TRUE.equals(officer.getOldValues().get(completed_detail_form));
    }

    /**
     * Queues the fresh envelope build for a V2 profile that was just completed (agentflow-gglqk). The
     * same unforced op call registerSigningAgreement makes, deferred by
     * {@link #PROFILE_COMPLETED_BUILD_DELAY_MILLIS}: on the KEYED submit, lf-homepage calls
     * registerSigningAgreement in the same sitting and builds first, and this task then finds that
     * envelope and reuses it (REUSE, no second envelope). On the keyless dedupe submit nothing else
     * builds, and this task does.
     */
    private void queueProfileCompletedBuild(String officerKey) {
      Server.queueService(QueueType.DEFAULT).addTask(EnsureSigningSessionsRegisterInterestedLoanOfficer.class,
              JSON.empty().key(officerKey), PROFILE_COMPLETED_BUILD_DELAY_MILLIS);
      Logger.getLogger(LORecruiting.class.getName()).info(
              "Queued the e-sign build for " + officerKey + ": RECRUIT_V2 profile completed");
    }

    /**
     * Whether {@code candidateKey} already has an Inkless envelope pending signature: a not-done
     * {@code SigningSession} carrying a non-empty {@code inkless_signing_id}. Mirrors the {@code
     * pendingEnvelopeIds} computation in {@link
     * EnsureSigningSessionsRegisterInterestedLoanOfficer#evaluateEnvelope} — a session that was
     * created but never actually sent (no id yet) does not count as "an envelope to regenerate".
     */
    private boolean hasUnsignedInklessEnvelope(String candidateKey) {
      return new Bundle().find(SigningSession.TYPE)
              .whereEquals(SigningSession.container, candidateKey)
              .whereEquals(SigningSession.use_inkless, true)
              .whereEquals(SigningSession.done, false)
              .list()
              .stream()
              .anyMatch(session -> Strings.isNotEmpty(session.get(SigningSession.inkless_signing_id)));
    }

    private void sendUpdateNotificationEmailToLOA(CanBeStored<?> officer, Field<Boolean> updateInfo) {
      if (officer.isChanged(updateInfo) && officer.is(updateInfo)) {
        String loaEmail = officer.get(LORecruiting.loan_officer_assistant.dot(Admin.company_email));
        String action = lo_agreement_signed.equals(updateInfo) ? "signed agreement" : updateInfo.label();
        if (Strings.isNotEmpty(loaEmail)) {
          String content = "Hi " + officer.get(LORecruiting.loan_officer_assistant.dot(Admin.first_name))
                  + "<br>Loan Officer " + officer.get(LORecruiting.full_name) + " has " + action;
          Server.queueService(QueueType.EMAIL).addTask(EmailTemplateOp.class, JSON.make(EmailParams.template, "action")
                  .set(Template.labels, Arrays.asList("email", officer.key()))
                  .set("title", "Loan Officer " + officer.get(LORecruiting.full_name) + " has " + action)
                  .set("body", content)
                  .set("action", coreMessages.view())
                  .set("url", Server.baseUrl() + "/lo_recruiting?_e=" + officer.key())
                  .set("to", Collections.singletonList(loaEmail)));
        }
      }
    }

    private void notifyReffererAboutStatus(CanBeStored<?> bean) {
      if (bean.isChanged(active) && bean.isNot(active) && hasRefferEmail(bean)) {
        List<String> cc = new ArrayList<>();
        HasValues recruiter = bean.load(LORecruiting.recruiter);
        if (bean.hasValue(onboarding_specialist)) {
          cc.add(bean.get(onboarding_specialist.dot(Admin.company_email)));
        }
        if (bean.isIn(status, WebinarAttendeeStatus.no_response, WebinarAttendeeStatus.denied_by_LO, WebinarAttendeeStatus.interviewed_and_rejected) &&
                bean.isIn(hr_status, HrStatus.in_progress, HrStatus.completed)) {
          cc.add(Server.getCompany().get(Company.hr_dept_email, ""));
          cc.add(Server.getCompany().get(Company.licensing_dept_email, ""));
        }
        String status = bean.hasValue(LORecruiting.status) ? String.valueOf(bean.get(LORecruiting.status)) : null;
        String nmlsStatus = bean.hasValue(LORecruiting.nmls_status) ? String.valueOf(bean.get(LORecruiting.nmls_status)) : null;
        Server.queueService(QueueType.EMAIL).addTask(EmailTemplateOp.class,
                JSON.make(EmailParams.template, "email/notify_referrer_ILOstatus")
                        .set("ilo", bean)
                        .set("cc", cc)
                        .set("recruiter", recruiter)
                        .set("status", status)
                        .set("nmlsStatus", nmlsStatus)
                        .set("iloOnboardingSpecialist", bean.load(onboarding_specialist)));
      }
    }

    private Boolean checkUserInBlackListOp(JSON input, Bundle bundle) {
      boolean checkExist;

      checkExist = checkIfExists(input, BlackListUser.email, bundle);
      checkExist = checkExist || checkIfExists(input, BlackListUser.phone, bundle);
      checkExist = checkExist || checkIfExists(input, BlackListUser.originator_nmls, bundle);

      return checkExist;
    }

    private boolean checkIfExists(JSON input, Field<String> inputField, Bundle bundle) {
      if (input.hasValue(inputField)) {
        return bundle.find(BlackListUser.TYPE)
                .whereEquals(inputField, input.get(inputField)).exists();
      }
      return false;
    }

    private boolean checkNotEligibleForRehire(HasValues bean, Bundle bundle) {
      String emailVal = bean.get(email, "");
      String nmlsVal = bean.get(nmls, "");
      if (!emailVal.isEmpty()) {
        if (bundle.find(Admin.TYPE)
                .whereEquals(Admin.email, emailVal)
                .whereEquals(Admin.not_eligible_for_rehire, true).exists()) {
          return true;
        }
      }
      if (!nmlsVal.isEmpty()) {
        if (bundle.find(Admin.TYPE)
                .whereEquals(Admin.originator_nmls, nmlsVal)
                .whereEquals(Admin.not_eligible_for_rehire, true).exists()) {
          return true;
        }
      }
      return false;
    }

    private void emailReferrerWhenILOAttend(CanBeStored<?> bean) {
      Bundle bundle = new Bundle();
      if (bean.hasValue(referrer) && bean.is(refer_loan_officer_email_me)) {
        HasValues recruiter = bundle.get(LORecruiter.TYPE, bean.get(referrer));
        if (bean.isChanged(is_attended) && bean.is(is_attended) && bean.hasValue(webinar)) {
          HasValues webinar = bundle.get(Webinar.TYPE, bean.get(LORecruiting.webinar));
          if (webinar != null && bean.hasValue(onboarding_specialist)) {
            String webinarTitle = webinar.get(Webinar.title);
            Server.queueService(QueueType.EMAIL).addTask(EmailTemplateOp.class,
                    JSON.make(EmailParams.template, "email_referrer_when_ILO_attend_webinar")
                            .set("root", bean.key())
                            .set("webinar_title", webinarTitle)
                            .set("date_of_webinar", Dates.dates.convertDateStringToFormat(webinar.get(Webinar.time), "MM-dd-yyyy h:mm a"))
                            .set("from", bean.get(onboarding_specialist.dot(Admin.company_email)))
                            .set("to", Collections.singletonList(bean.get(LORecruiting.referrer)))
                            .set("recruiter", recruiter));
          }
        }
        if (bean.isChanged(status) && bean.is(status, WebinarAttendeeStatus.joined)) {
          boolean referrerIsLO = recruiter.is(LORecruiter.is_internal_loan_officers);
          Server.queueService(QueueType.EMAIL).addTask(EmailTemplateOp.class,
                  JSON.make(EmailParams.template, "email_referrer_when_ILO_onboarded")
                          .set("to", Collections.singletonList(bean.get(LORecruiting.referrer)))
                          .set("referrer_is_lo", referrerIsLO)
                          .set("root", bean.key())
                          .set("recruiter", recruiter));
        }

      }

    }

    private void sendEmailWhenHrCompleted(CanBeStored<?> bean) {
      Server.queueService(QueueType.EMAIL).addTask(EmailTemplateOp.class,
              JSON.make(EmailParams.template, "hr_status_changed_to_completed")
                      .set("root", bean.key())
                      .set("to", Collections.singletonList(bean.get(LORecruiting.onboarding_specialist.dot(Admin.company_email))))
                      .set("from", App.currentUser().get(Admin.company_email))
                      .set("onboarding_specialist_full_name", bean.get(LORecruiting.onboarding_specialist.dot(Admin.full_name)))
                      .set("url", Server.baseUrl() + "/lo_recruiting/company?labels=" + bean.get(LORecruiting.email))
      );
    }

    private void sendEmailWhenILOJoinedCompany(Bean adminConvertFromILO) {
      if (LOAN_FACTORY.equals(App.ns())) {
        Server.queueService(QueueType.EMAIL).addTask(EmailTemplateOp.class, JSON.make(EmailParams.template, "email/lender_credential_guide")
                .set("root", adminConvertFromILO.key()));
      }
    }

    private void createEscalationDeskTicket(CanBeStored<?> bean) {
      List<String> autoEscalationTickets = new ArrayList<>();

      if (bean.isChanged(onboarding_meeting_status) && bean.is(onboarding_meeting_status, StatusMeeting.pre_onboarding_done) && bean.is(LORecruiting.recruiting_type, RecruitingType.interested)
              && bean.is(LORecruiting.status, WebinarAttendeeStatus.interviewed_and_accepted) && bean.is(LORecruiting.hr_status, HrStatus.completed)) {
        autoEscalationTickets.add(AutoEscalationDesk.ILO_IS_PRE_ONBOARDING_DONE_AND_IS_HR_COMPLETED_AND_IS_ONBOARDING);
      }

      boolean isAccepted = bean.is(status, WebinarAttendeeStatus.interviewed_and_accepted);
      boolean isPreMeetingDone = bean.is(onboarding_meeting_status, StatusMeeting.pre_onboarding_done);
      if (changedAny(bean, status, paid_startup_fee)
              && isAccepted
              && bean.is(paid_startup_fee)) {
        autoEscalationTickets.add(AutoEscalationDesk.ILO_ONBOARDING_STATUS_ONBOARDING_FEE_PAID);
      }

      if (changedAny(bean, onboarding_meeting_status, paid_startup_fee, waive_startup_fee, lo_agreement_signed, status, hr_status)
              && isPreMeetingDone
              && (bean.is(paid_startup_fee) || bean.is(waive_startup_fee))
              && bean.is(lo_agreement_signed)
              && isAccepted
              && bean.is(hr_status, HrStatus.in_progress)) {
        autoEscalationTickets.add(AutoEscalationDesk.ILO_PRE_MEETING_FEE_SIGNED);
      }

      if (changedAny(bean, onboarding_meeting_status, paid_startup_fee, waive_startup_fee, lo_agreement_signed, status, recruiting_license_status, hr_status)
              && isPreMeetingDone
              && (bean.is(paid_startup_fee) || bean.is(waive_startup_fee))
              && bean.is(lo_agreement_signed)
              && isAccepted
              && bean.is(recruiting_license_status, RecruitingLicenseStatus.nmls_licensed)
              && bean.is(hr_status, HrStatus.not_initiated)) {
        autoEscalationTickets.add(AutoEscalationDesk.ILO_CREATED_US_BRANCH_CONTRACTOR);
      }

      if (changedAny(bean, status, nmls_status, hr_status)
              && isAccepted
              && bean.is(nmls_status, NmlsStatus.sponsored)
              && bean.is(hr_status, HrStatus.in_progress)) {
        autoEscalationTickets.add(AutoEscalationDesk.ILO_ONBOARDING_SPONSORED_HR);
      }

      if (changedAny(bean, onboarding_meeting_status, hr_status)
              && isPreMeetingDone
              && bean.is(hr_status, HrStatus.completed)) {
        autoEscalationTickets.add(AutoEscalationDesk.ILO_PRE_MEETING_HR_DONE);
      }

      if (changedAny(bean, hr_status, nmls_status, status)
              && bean.is(hr_status, HrStatus.completed)
              && bean.is(nmls_status, NmlsStatus.sponsored)
              && bean.is(status, WebinarAttendeeStatus.joined)) {
        autoEscalationTickets.add(AutoEscalationDesk.ILO_HR_DONE_NMLS_SPONSORED);
        autoEscalationTickets.add(AutoEscalationDesk.ILO_AGREEMENT_SIGNED_ALL_DONE);
      }

      if (changedAny(bean, status, nmls_status) && bean.isIn(status, WebinarAttendeeStatus.joined, WebinarAttendeeStatus.interviewed_and_accepted)
              && bean.is(nmls_status, NmlsStatus.access_removal)) {
        autoEscalationTickets.add(AutoEscalationDesk.ILO_NMLS_ACCESS_REMOVAL);
      }

      if (changedAny(bean, paid_startup_fee, waive_startup_fee, lo_agreement_signed, recruiting_license_status)
              && bean.is(recruiting_license_status, RecruitingLicenseStatus.nmls_na)
              && (bean.is(paid_startup_fee) || bean.is(waive_startup_fee)) && bean.is(lo_agreement_signed)) {
        autoEscalationTickets.add(AutoEscalationDesk.ILO_NMLS_STATUS_NA);
      }

      if (bean.isChanged(status) && bean.is(status, WebinarAttendeeStatus.interviewed_and_accepted)) {
        autoEscalationTickets.add(AutoEscalationDesk.NEW_ASSOCIATE_CREATED_US_BRANCH_CONTRACTOR);
      }

      // Ticket: ILO Status is No Response AND HR status is Pending BGC or HR Onboarding or HR Completed
      if (changedAny(bean, status, hr_status)
              && bean.is(status, WebinarAttendeeStatus.no_response)
              && bean.isIn(hr_status, HrStatus.pending_bgc_or_az_docs, HrStatus.in_progress, HrStatus.completed)) {
        autoEscalationTickets.add(AutoEscalationDesk.ILO_STATUS_NO_RESPONSE_HR_PENDING_OR_ONBOARDING_OR_COMPLETED);
      }

      if (changedAny(bean, status, hr_status)
              && bean.isIn(status, WebinarAttendeeStatus.denied_by_LO, WebinarAttendeeStatus.interviewed_and_rejected)
              && bean.isIn(hr_status, HrStatus.in_progress, HrStatus.completed)) {
        Bundle bundle = new Bundle();
        Bean adminConvertFromILO = bundle.find(Admin.TYPE).whereEquals(Admin.converted_from_ilo, bean.key()).first();
        if (adminConvertFromILO != null && adminConvertFromILO.is(Admin.active)) {
          AutoEscalationDesk.createAutoEscalationTicket(adminConvertFromILO, AutoEscalationDesk.ACTIVE_LO_HAS_ILO_DENIED);
        }
      }

      if (changedAny(bean, status, hr_status)
              && bean.is(status, WebinarAttendeeStatus.interviewed_and_accepted)
              && bean.is(hr_status, HrStatus.done_bgc_or_az_docs)) {
        autoEscalationTickets.add(AutoEscalationDesk.ILO_ONBOARDING_HR_DONE_BGC_AZ_DOCS);
      }

      if (!autoEscalationTickets.isEmpty()) {
        Server.queueService().addTask(CreateAutoEscalationTicketsOp.class, FieldsBase.create()
                .set(AutoEscalationDesk.keyName.s(), autoEscalationTickets)
                .set(Loan.key, bean.key()));
      }
    }

    private boolean changedAny(CanBeStored<?> b, Field<?>... fields) {
      return Arrays.stream(fields).anyMatch(b::isChanged);
    }

  });
}