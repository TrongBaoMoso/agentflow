  Field<String> referred_source_other_reason = TYPE.f("referred_source_other_reason", "Other reason", true, StringType.instance()).track();

  Field<Boolean> ready_to_join = TYPE.f("ready_to_join", BooleanType.instance()).track();

  Field<String> appointment_time = TYPE.f("appointment_time", StringType.instance());
