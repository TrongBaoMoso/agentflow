  String APPOINTMENT_DATE_TIME_FORMAT = "MM/dd/yyyy HH:mm a";
  String EMAIL_ID_PREFIX = "lo-recruit-email-id=";

  Field<Boolean> register_for_webinar = TYPE.f("register_for_webinar", BooleanType.instance()).track();
  Field<Boolean> not_registered_webinar = TYPE.f("not_registered_webinar", "Not registered webinar", true, BooleanType.instance()).track();
  /**
   * Filter-only: the id of a {@link TradeShow} whose {@code has_vip_after_party} is on, used to
   * narrow the interested-loan-officer list to the people who registered for that show.
   *
   * <p>Not persisted, and deliberately not a field on the row: there is no ILO -> trade show
   * reference in Datastore. The link is the registration itself — a {@link TradeShowAttendee}
   * under the show carrying the person's email — so the filter is resolved by
   * {@code FindInterestedLoanOfficersOp}, which turns the selected show into its attendee emails
   * and matches those against {@link #email}. Anything reading this off a row will get nothing.</p>
   */
  Field<Long> registered_vip_after_party_show = TYPE.f("registered_vip_after_party_show", "Registered VIP After Party", true, LongType.instance()).persistable(false);
  Field<Boolean> paid_startup_fee = TYPE.f("paid_startup_fee", BooleanType.instance()).defaultValue(false).track();
  Field<Boolean> waive_startup_fee = TYPE.f("waive_startup_fee", BooleanType.instance()).defaultValue(false).track();
  Field<String> waive_startup_fee_reason = TYPE.f("waive_startup_fee_reason", StringType.instance()).track();
  Field<String> startup_fee_status = TYPE.f("startup_fee_status", "Startup fee", false, StringType.instance())
          .function(officer -> Optional.of(officer.is(waive_startup_fee) ? loanMessages.waived()
                  : officer.is(paid_startup_fee) ? commissionMessages.paid()
                  : commissionMessages.unpaid()));
  Field<String> paypal_order_id = TYPE.f("paypal_order_id", StringType.instance()).track();

  Field<Boolean> completed_detail_form = TYPE.f("completed_detail_form", BooleanType.instance()).track();

  Field<Double> target_compensation = TYPE.f("target_compensation", true, DecimalType.percentage());
  Field<Double> rocket_target_compensation = TYPE.f("rocket_target_compensation", true, DecimalType.percentage()).track();
  Field<String> office_phone = TYPE.f("office_phone", "Office phone", true, StringType.phone()).track();
  Field<String> bio = TYPE.f("bio", "About/Bio", false, StringType.html());
  Field<String> website = TYPE.f("website", false, StringType.instance()).is(Validators.url());
  Field<String> company_name = TYPE.f("company_name", false, StringType.instance()).track();
  Field<String> company_url = TYPE.f("company_url", false, StringType.instance()).is(Validators.url()).track();
  Field<String> company_nmls = TYPE.f("company_nmls", false, StringType.instance()).track();

  Field<RecruitingType> recruiting_type = TYPE.f("recruiting_type", EnumType.instance(RecruitingType.class)).track();
  Field<OutSourceStatus> out_source_status = TYPE.f("out_source_status", "Status", true, EnumType.instance(OutSourceStatus.class)).track();
  Field<Boolean> out_source_active = TYPE.f("out_source_active", "Active", true, BooleanType.instance()).track();
  Field<Friendship> friendship = TYPE.f("friendship", EnumType.instance(Friendship.class)).defaultValue(Friendship.not_friend).track();
  Field<Channel> channel = TYPE.f("channel", "Loan officer channel", true, EnumType.instance(Channel.class)).track();
  Field<Boolean> claimed_profile = TYPE.f("claimed_profile", BooleanType.instance()).track();
  Field<Boolean> claimed_profile_want_join = TYPE.f("claimed_profile_want_join", BooleanType.instance()).persistable(false);
  Field<Boolean> pending_approval = TYPE.f("pending_approval", BooleanType.instance()).track();
  Field<Boolean> block_display = TYPE.f("block_display", BooleanType.instance()).track();
  Field<NotificationMethodType> communication_method = TYPE.f("communication_method", "Preferred method of communication?", false, EnumType.instance(NotificationMethodType.class)).track();
  Field<Boolean> paid_and_signed = TYPE.f("paid_and_signed", "Paid and Signed", false, BooleanType.instance())
          .function(input -> Optional.of(input.is(paid_startup_fee) && input.is(lo_agreement_signed)));
  Field<Boolean> check_social_media = TYPE.f("check_social_media", "Check social media?", true, BooleanType.instance()).track();
  Field<Boolean> has_social_media = TYPE.f("has_social_media", BooleanType.instance());

  Field<List<String>> lo_labels = TYPE.f("lo_labels", "Labels", false, StringType.instance().listType().unique()).access(PUBLIC).track().defaultOptional(Optional.nullOptional());
  Field<List<String>> lo_search_labels = TYPE.f("lo_search_labels", "Search Labels", false, StringType.instance().listType().unique()).access(PUBLIC).track().defaultOptional(Optional.nullOptional());
  // WHEN this row last arrived through a public registration form, and WHICH event it was for.
  // Stamped only by RegisterInterestedLoanOfficer (the RSVP / recruiting-form path); an admin
  // editing the record in the back office goes through a plain SaveOp and leaves them untouched.
  //
  // That separation is the whole point. Downstream (recruit-be) a row is delivered again on ANY
  // save, machine or human, and the row's CONTENT is identical either way — a QA record was
  // observed receiving two identical `lorecruiting.saved` deliveries 32 minutes apart with
  // nobody having registered in between. Without a registration clock there is no way to tell
  // "this person raised their hand again" from "something re-saved the row", and a system that
  // guesses will tell a recruiter someone came back when they did not.
  //
  // lo_labels alone cannot answer it: it is a unique-value list, so a second registration for an
  // event already in the list changes nothing at all, and the list never says which entry is the
  // latest one.
  Field<Date> last_registration_at = TYPE.f("last_registration_at", "Last registration at", false, DateType.datetime()).track();
  Field<String> last_registration_event = TYPE.f("last_registration_event", "Last registration event", false, StringType.instance()).track();

  // Origin stamp (agentflow-cn1rh P1a): WHICH entry page created this row. Written ONCE, at create, by
  // LeadOriginStamp; every field below except lead_origin/lead_origin_slug is derived server-side and is
  // never taken from a request. lead_origin and lead_origin_owner_key are INDEXED (third argument true):
  // the P2a read op (ReferralByOwner) finds a referrer's rows by equality on them. Plain strings (not an enum) so a malformed client value is dropped by
  // LeadOriginStamp instead of failing the whole registration. See LeadOriginStamp for the value sets.
  Field<String> lead_origin = TYPE.f("lead_origin", "Lead origin", true, StringType.instance());
  Field<String> lead_origin_slug = TYPE.f("lead_origin_slug", "Lead origin slug", false, StringType.instance());
  Field<String> lead_origin_owner_key = TYPE.f("lead_origin_owner_key", "Lead origin owner key", true, StringType.instance());
  Field<String> lead_origin_owner_email = TYPE.f("lead_origin_owner_email", "Lead origin owner email", false, StringType.instance());
  Field<String> lead_origin_owner_match = TYPE.f("lead_origin_owner_match", "Lead origin owner match", false, StringType.instance());
  Field<String> lead_origin_reject = TYPE.f("lead_origin_reject", "Lead origin reject reason", false, StringType.instance());
  Field<Date> lead_origin_at = TYPE.f("lead_origin_at", "Lead origin stamped at", false, DateType.datetime());

  /**
   * Which agreement flow this row follows (agentflow-7mwf0, "Option C"). {@code null} is the legacy MOSO
   * desk and the whole pre-existing behaviour; {@link #AGREEMENT_FLOW_RECRUIT_V2} marks a row recruit-be
   * hands to the onboarding specialist WITHOUT the invite email, whose agreement is built when the LO
   * submits the profile after the 1-1, not at "Done".
   *
   * <p>Write-once by exactly one writer: {@code RecruitAPI.recordOnboardingMeeting}, in the same save as
   * {@code onboarding_meeting_status=pre_onboarding_done}, and only on an explicit request flag. Never
   * stamped from a public form: {@code RegisterInterestedLoanOfficer#protectAgreementFlow} strips it from
   * every public body. No MOSO view lists it, so the dropdown and the GWT forms cannot set it either.</p>
   */
  Field<String> agreement_flow = TYPE.f("agreement_flow", "Agreement flow", false, StringType.instance()).track();
  String AGREEMENT_FLOW_RECRUIT_V2 = "RECRUIT_V2";

  /**
   * How long the build queued when a RECRUIT_V2 profile is completed waits (agentflow-gglqk), so the
   * keyed form's own registerSigningAgreement, sent right after the save, builds first and the queued
   * build only reuses that envelope.
   */
  long PROFILE_COMPLETED_BUILD_DELAY_MILLIS = 60_000L;

  /** True only for a row stamped {@link #AGREEMENT_FLOW_RECRUIT_V2}; null, blank or any other value is the legacy desk. */
  static boolean isRecruitV2(HasValues row) {
    return row != null && AGREEMENT_FLOW_RECRUIT_V2.equals(row.get(agreement_flow));
  }

