    @Override
    public String toString() {
      return Strings.toTitle(name());
    }

    public static String getButtonStyle(Friendship value) {
      String color = not_friend.equals(value) ? "#f44336"
              : friend_requested.equals(value) ? "#ffc107"
              : cannot_make_friend_request.equals(value) ? "#894c23"
              : friend.equals(value) ? "#009688"
              : "#6c757d";
      return "color:white;background-color:" + color + ";";
    }
  }

