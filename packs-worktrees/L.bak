        HasCommunicationStatisticSummary, HasProgress, HasLoanPriority, HasUtmCampaign, GoogleReview, HasTCPAConsent, HasESign, HasBlackListed {
  Type TYPE = Type.add(LORecruiting.class, WebinarAttendee.TYPE, HasFollowUp.TYPE, HasAddedByAdmin.TYPE, HasProgress.TYPE, HasReferInfo.TYPE)
          .trackCreation(true).trackUpdate(true).captureAuditLog(true);

  Field<Boolean> brokerage = TYPE.f("brokerage", "LO is NOT exclusively originating loans with Loan Factory", true, BooleanType.instance()).track();
  Field<List<String>> sponsor_states = TYPE.f("sponsor_states", StringType.instance().listType()).track();
  Field<String> sponsor_state = TYPE.f("sponsor_state", StringType.instance()).track();
  Field<String> nmls = TYPE.f("nmls", "NMLS", true, StringType.instance()).track()
          .is(new RegExValidator(Agent.NMLS_REGEX, loanMessages.invalid_format_nmls_message()));
  Field<NmlsStatus> nmls_status = TYPE.f("nmls_status", "NMLS status", true, EnumType.instance(NmlsStatus.class)).track();
  Field<Date> nmls_sponsor_first_day = TYPE.f("nmls_sponsor_first_day", DateType.datetime());
  Field<Date> nmls_sponsor_last_day = TYPE.f("nmls_sponsor_last_day", DateType.datetime());
  Field<Date> temporary_nmls_sponsor_first_day = TYPE.f("temporary_nmls_sponsor_first_day", DateType.datetime());
  Field<String> nmls_sponsor_duration = TYPE.f("nmls_sponsor_duration", "NMLS sponsor duration", false, StringType.instance()).function(item -> {
    String result;
    Integer duration = LORecruitingUtils.calDuration(item);
    if (duration == null) {
      result = "N/A";
    } else {
      result = duration + " day(s)";
    }

    return Optional.of(result);
  });
  Field<HrStatus> hr_status = TYPE.f("hr_status", "HR status", true, EnumType.instance(HrStatus.class)).defaultValue(HrStatus.not_initiated).track();
  @Deprecated
  Field<OnboardingSupportStatus> onboarding_support_status = TYPE.f("onboarding_support_status", "Onboarding Support Status", true, EnumType.instance(OnboardingSupportStatus.class)).defaultValue(OnboardingSupportStatus.onboarding_intro_not_scheduled);
  Field<Boolean> give_nmls_access = TYPE.f("give_nmls_access", BooleanType.instance()).track();
  Field<Integer> annual_volume = TYPE.f("annual_volume", IntegerType.instance()).track();
  Field<List<String>> lo_agreements = TYPE.f("lo_agreements", "Upload Agreements", true, StringType.instance().listType());
  Field<String> lo_agreement = TYPE.f("lo_agreement", "Upload Agreement", true, StringType.instance()).track();
  FK<List<String>> associate_todo_folders = TYPE.fk("associate_todo_folders", false, StringType.instance().listType()).ref(DriveFile.TYPE);
  Field<Boolean> lo_agreement_signed = TYPE.f("lo_agreement_signed", "Agreement signed", true, BooleanType.instance()).defaultValue(false).track();
  Field<Boolean> is_from_fb_ad = TYPE.f("is_from_fb_ad", true, BooleanType.instance()).track();

  Field<Boolean> is_corporate_loan_officer = TYPE.f("is_corporate_loan_officer", "Loan officer type", true, BooleanType.instance()).track();
  Field<Boolean> referred_by_lo = TYPE.f("referred_by_source", BooleanType.instance()).track();
  Field<Boolean> referred_by_lo_inside = TYPE.f("referred_by_lo_inside", BooleanType.instance()).track();
  Field<Boolean> may_reach_to_us_before = TYPE.f("may_reach_to_us_before", BooleanType.instance());
  Field<Long> ref = TYPE.f("ref", LongType.instance()).persistable(false);
  Field<Experience> experience = TYPE.f("experience", EnumType.instance(Experience.class)).track();
  Field<String> experience_name = TYPE.f("experience_name", false, StringType.instance())
          .function(item -> item.hasValue(experience) ? Optional.of(item.get(experience).toString()) : Optional.of(""));
  Field<YesNo> required_to_join_membership = TYPE.f("required_to_join_membership", "Required to join membership", true, EnumType.instance(YesNo.class)).track();
  Field<Integer> closed_loan_past_12_months = TYPE.f("closed_loan_past_12_months", "Closed loan in 12 months", true, IntegerType.instance()).track();
  Field<Double> total_volume_past_12_months = TYPE.f("total_volume_past_12_months", "total volume 12-month loans", true, DecimalType.money()).min(0.0).track();
  Field<List<HasValues>> trans_history_past_12_months = TYPE.f("trans_history_past_12_months", "Transaction history in the past 12 months", false, JsonArrayType.objects()).track();
  Field<Integer> closed_loan_since_2021 = TYPE.f("closed_loan_since_2021", "Loans since 2021", true, IntegerType.instance()).track();
  Field<String> licensed_since = TYPE.f("licensed_since", StringType.dateOnly()).track();
  Field<Integer> months_in_business = TYPE.f("months_in_business", "Years in business", false, IntegerType.instance()).function(officer -> {
    if (officer.hasValue(licensed_since)) {
      return Optional.of(Dates.dates.getMonthsBetween(new Date(), Dates.dates.getDateFromISOString(officer.get(licensed_since))));
    }
    return Optional.absent();
  });
  Field<Double> total_volume = TYPE.f("total_volume", DecimalType.money()).track().min(0D);
  Field<Integer> total_closed_loan = TYPE.f("total_closed_loan", IntegerType.instance()).track().min(0);
  Field<Integer> approximately_closed_loans = TYPE.f("approximately_closed_loans", "Approximately, how many loans closed by this loan officer?", true, IntegerType.instance()).track();

